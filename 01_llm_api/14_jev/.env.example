# Jev is called through OpenRouter - no TypeSafe account needed.
# Jev is NOT free: it needs OpenRouter credits (about $0.00002 per call).
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: pin a Jev version (default typesafe/jev-1.13) or use ~typesafe/jev-latest
# JEV_MODEL=typesafe/jev-1.13

# Optional: the LLM used in 1_basics (6, 7) and 3_other_use_cases (1, 2)
# LLM_MODEL=openai/gpt-5.4-mini

# Optional: run every script on a LOCAL Kev server instead of Jev (see 4_local_kev)
# JEV_URL=http://localhost:8009/v1/systemone
# JEV_MODEL=kev-latest
