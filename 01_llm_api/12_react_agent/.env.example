# =============================================================================
# ONE ReAct agent, ANY provider.
#
# Pick a provider below: set MODEL to a LiteLLM model string and provide the
# matching API key. LiteLLM reads the standard <PROVIDER>_API_KEY env vars
# automatically. Only local providers (LM Studio, Ollama) need API_BASE.
#
# LiteLLM providers & model strings: https://docs.litellm.ai/docs/providers
# =============================================================================

# ---- OpenRouter (free Gemma model — default) --------------------------------
MODEL=openrouter/google/gemma-4-31b-it:free
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ---- OpenAI -----------------------------------------------------------------
# MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key-here

# ---- Anthropic --------------------------------------------------------------
# MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ---- Google Gemini ----------------------------------------------------------
# MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=your-gemini-api-key-here

# ---- xAI Grok ---------------------------------------------------------------
# MODEL=xai/grok-4
# XAI_API_KEY=your-xai-api-key-here

# ---- HuggingFace ------------------------------------------------------------
# MODEL=huggingface/novita/meta-llama/llama-3.2-3b-instruct
# HF_TOKEN=your-hf-token-here

# ---- LM Studio (local, OpenAI-compatible) -----------------------------------
# MODEL=openai/google/gemma-4-e4b
# API_BASE=http://localhost:1234/v1
# OPENAI_API_KEY=none

# ---- Ollama (local) ---------------------------------------------------------
# MODEL=ollama/llama3.2
# API_BASE=http://localhost:11434
