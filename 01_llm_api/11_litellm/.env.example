# LiteLLM proxy master key (clients authenticate to the proxy with this)
LITELLM_MASTER_KEY=sk-mysecretkey

# --- Provider API keys (read by litellm_config.yaml via os.environ/...) -------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
XAI_API_KEY=your-xai-api-key-here
HF_TOKEN=your-hf-token-here

# --- Local engines -----------------------------------------------------------
# Ollama and LM Studio need no key. Unsloth Studio does - it 401s on every route
# without one. Create it in the app: Settings > API > API keys.
UNSLOTH_API_KEY=your-unsloth-api-key-here
